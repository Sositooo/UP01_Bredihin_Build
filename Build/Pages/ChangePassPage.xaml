<Page x:Class="Build.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="440" Margin="0,24" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Смена пароля" Style="{StaticResource Heading}" FontSize="22" Margin="0,0,0,20"/>

                <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TbLogin" Tag="Ваш логин" ToolTip="Введите логин от своей учётной записи"/>

                <TextBlock Text="Текущий пароль" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="OldPass" ToolTip="Введите текущий пароль" PasswordChanged="Pass_Changed"/>
                    <TextBlock Text="Текущий пароль" Style="{StaticResource HintText}"/>
                </Grid>

                <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="NewPass" ToolTip="Минимум 6 символов, английская раскладка, хотя бы одна цифра"
                                 PasswordChanged="Pass_Changed"/>
                    <TextBlock Text="Новый пароль" Style="{StaticResource HintText}"/>
                </Grid>

                <TextBlock Text="Подтверждение нового пароля" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="NewPass2" ToolTip="Повторите новый пароль" PasswordChanged="Pass_Changed"/>
                    <TextBlock Text="Повторите новый пароль" Style="{StaticResource HintText}"/>
                </Grid>

                <Button x:Name="BtnSave" Content="Сохранить" Margin="6,12,6,6"
                        ToolTip="Сохранить новый пароль" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
