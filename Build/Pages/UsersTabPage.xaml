<Page x:Class="Build.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица пользователей">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ПОИСК, ФИЛЬТР, СОРТИРОВКА -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,16,16,4" Margin="0,0,0,16">
            <WrapPanel>
                <TextBox x:Name="SearchBox" Width="270" Margin="0,0,12,12" Tag="🔍 Поиск по ФИО или логину"
                         ToolTip="Введите часть ФИО или логина" TextChanged="Filter_Changed"/>
                <ComboBox x:Name="RoleFilter" Width="210" Margin="0,0,12,12" DisplayMemberPath="Name"
                          ToolTip="Фильтр по роли" SelectionChanged="Filter_Changed"/>
                <ComboBox x:Name="SortBox" Width="210" Margin="0,0,12,12" SelectedIndex="0"
                          ToolTip="Порядок сортировки по ФИО" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="ФИО: А → Я"/>
                    <ComboBoxItem Content="ФИО: Я → А"/>
                </ComboBox>
                <Button Content="Сбросить" Margin="0,0,12,12" Style="{StaticResource OutlineButton}"
                        ToolTip="Очистить поиск и фильтры" Click="Reset_Click"/>
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" ToolTip="Выберите строку (или несколько с Ctrl) и нажмите кнопку внизу">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Добавить" ToolTip="Добавить пользователя" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" ToolTip="Изменить выбранного пользователя" Click="BtnEdit_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}"
                    ToolTip="Удалить выбранных пользователей" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Page>
