<Page x:Class="Build.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователь">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="460" Margin="0,24" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Данные пользователя" Style="{StaticResource Heading}" FontSize="22" Margin="0,0,0,20"/>

                <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TbLogin" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Например, ivanov_s" ToolTip="Логин: 3–20 символов, английские буквы, цифры и _"/>

                <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TbFio" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Иванов Иван Иванович" ToolTip="ФИО русскими буквами"/>

                <TextBlock Text="Роль" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="RoleBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding RoleId}" ToolTip="Выберите роль"/>

                <TextBlock x:Name="PassLabel" Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="PassBox" ToolTip="Минимум 6 символов, английская раскладка, хотя бы одна цифра"
                                 PasswordChanged="Pass_Changed"/>
                    <TextBlock x:Name="PassHintText" Text="Пароль" Style="{StaticResource HintText}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="Сохранить" ToolTip="Сохранить данные" Click="BtnSave_Click"/>
                    <Button Content="Очистить" Style="{StaticResource OutlineButton}"
                            ToolTip="Очистить поля формы" Click="BtnClean_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
