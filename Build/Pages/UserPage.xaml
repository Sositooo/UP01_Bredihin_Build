<Page x:Class="Build.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог техники">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ПАНЕЛЬ ПОИСКА, ФИЛЬТРА И СОРТИРОВКИ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,16,16,4" Margin="0,0,0,16">
            <WrapPanel>
                <TextBox x:Name="SearchBox" Width="270" Margin="0,0,12,12" Tag="🔍 Поиск по названию или модели"
                         ToolTip="Введите часть названия или модели техники" TextChanged="Filter_Changed"/>
                <ComboBox x:Name="CategoryBox" Width="210" Margin="0,0,12,12" DisplayMemberPath="Name"
                          ToolTip="Фильтр по категории техники" SelectionChanged="Filter_Changed"/>
                <ComboBox x:Name="SortBox" Width="210" Margin="0,0,12,12" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Сначала дешёвые"/>
                    <ComboBoxItem Content="Сначала дорогие"/>
                    <ComboBoxItem Content="По названию А–Я"/>
                </ComboBox>
                <CheckBox x:Name="OnlyOkCheck" Content="Только исправные" Margin="0,0,12,12" VerticalAlignment="Center"
                          ToolTip="Показать только технику, готовую к аренде"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <Button Content="Сбросить" Margin="0,0,12,12" Style="{StaticResource OutlineButton}"
                        ToolTip="Очистить поиск и фильтры" Click="Reset_Click"/>
                <TextBlock x:Name="CountText" Margin="0,0,0,12" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
            </WrapPanel>
        </Border>

        <!-- КАРТОЧКИ ТЕХНИКИ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="MachinesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250" Margin="0,0,16,16" CornerRadius="14" ClipToBounds="True"
                                    Background="{DynamicResource CardBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Height="150">
                                        <!-- запасной вариант, если у техники нет фото или ссылка не открылась -->
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="14,14,0,0">
                                            <TextBlock Text="🚜" FontSize="44" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- фото по ссылке из столбца PhotoUrl -->
                                        <Border CornerRadius="14,14,0,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding PhotoUrl}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="16,12,16,16">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" MinHeight="44"/>
                                        <TextBlock Text="{Binding Model}" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="{Binding CategoryName}" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DailyPrice, StringFormat='{}{0:N0} ₽ / сутки'}"
                                                   FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding DepositAmount, StringFormat='Залог: {0:N0} ₽'}"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="{Binding MinRentDays, StringFormat='Минимальный срок: {0} дн.'}"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="{Binding Status, StringFormat='● {0}'}" FontWeight="Bold" Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="На обслуживании">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Списана">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Сообщение, если по фильтрам ничего не нашлось -->
                <TextBlock x:Name="EmptyText" Text="По вашему запросу техника не найдена" FontSize="16"
                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                           Margin="0,40,0,0" Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
