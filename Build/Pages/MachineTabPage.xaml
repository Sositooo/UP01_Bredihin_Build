<Page x:Class="Build.Pages.MachineTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица техники">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ПОИСК, ФИЛЬТРЫ, СОРТИРОВКА -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,16,16,4" Margin="0,0,0,16">
            <WrapPanel>
                <TextBox x:Name="SearchBox" Width="250" Margin="0,0,12,12" Tag="🔍 Название, модель, номер"
                         ToolTip="Поиск по названию, модели или инвентарному номеру" TextChanged="Filter_Changed"/>
                <ComboBox x:Name="CategoryBox" Width="190" Margin="0,0,12,12" DisplayMemberPath="Name"
                          ToolTip="Фильтр по категории" SelectionChanged="Filter_Changed"/>
                <ComboBox x:Name="StatusBox" Width="190" Margin="0,0,12,12" SelectedIndex="0"
                          ToolTip="Фильтр по состоянию техники" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Все статусы"/>
                    <ComboBoxItem Content="Исправна"/>
                    <ComboBoxItem Content="На обслуживании"/>
                    <ComboBoxItem Content="Списана"/>
                </ComboBox>
                <ComboBox x:Name="SortBox" Width="190" Margin="0,0,12,12" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="По названию А–Я"/>
                    <ComboBoxItem Content="Сначала дешёвые"/>
                    <ComboBoxItem Content="Сначала дорогие"/>
                </ComboBox>
                <Button Content="Сбросить" Margin="0,0,12,12" Style="{StaticResource OutlineButton}"
                        ToolTip="Очистить поиск и фильтры" Click="Reset_Click"/>
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="MachineGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" ToolTip="Выберите строку (или несколько с Ctrl) и нажмите кнопку внизу">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.6*"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="1.2*"/>
                <DataGridTextColumn Header="Инв. №" Binding="{Binding InventoryNumber}" Width="0.8*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="1.2*"/>
                <DataGridTextColumn Header="Год" Binding="{Binding ManufactureYear}" Width="0.6*"/>
                <DataGridTextColumn Header="Цена/сутки" Binding="{Binding DailyPrice, StringFormat='{}{0:N0} ₽'}" Width="1*"/>
                <DataGridTextColumn Header="Залог" Binding="{Binding DepositAmount, StringFormat='{}{0:N0} ₽'}" Width="1*"/>
                <DataGridTextColumn Header="Мин. дн." Binding="{Binding MinRentDays}" Width="0.7*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Добавить" ToolTip="Добавить технику" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" ToolTip="Изменить выбранную технику" Click="BtnEdit_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}"
                    ToolTip="Удалить выбранную технику" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Page>
