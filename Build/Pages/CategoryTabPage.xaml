<Page x:Class="Build.Pages.CategoryTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица категорий техники">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,16,16,4" Margin="0,0,0,16">
            <WrapPanel>
                <TextBox x:Name="SearchBox" Width="270" Margin="0,0,12,12" Tag="🔍 Поиск по названию"
                         ToolTip="Введите часть названия категории" TextChanged="Filter_Changed"/>
                <ComboBox x:Name="SortBox" Width="210" Margin="0,0,12,12" SelectedIndex="0"
                          ToolTip="Порядок сортировки по названию" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Название: А → Я"/>
                    <ComboBoxItem Content="Название: Я → А"/>
                </ComboBox>
                <Button Content="Сбросить" Margin="0,0,12,12" Style="{StaticResource OutlineButton}"
                        ToolTip="Очистить поиск и сортировку" Click="Reset_Click"/>
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="CategoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" ToolTip="Выберите строку (или несколько с Ctrl) и нажмите кнопку внизу">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Категория" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Добавить" ToolTip="Добавить категорию" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" ToolTip="Изменить выбранную категорию" Click="BtnEdit_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}"
                    ToolTip="Удалить выбранные категории вместе с их техникой" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Page>
