<Window x:Class="Build.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="ru-RU"
        Title="Build" Width="1180" Height="720" MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="/res/build.ico"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <!-- Окно делится на 3 строки: верхняя панель / Frame со страницами / нижняя панель -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: Назад | заголовок страницы | Тема | Выйти -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Заголовок меняется на каждой странице (берётся из Page.Title).
                     Растянут на все 4 колонки и лежит под кнопками, поэтому стоит ровно по центру окна -->
                <TextBlock x:Name="PageTitle" Grid.ColumnSpan="4" Text="Build" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource HeaderTextBrush}" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="BackButton" Grid.Column="0" Content="← Назад" Click="BackButton_Click"
                        ToolTip="Вернуться на предыдущую страницу" Visibility="Collapsed"/>
                <Button x:Name="ThemeButton" Grid.Column="2" Content="Сменить тему" Click="ThemeButton_Click"
                        ToolTip="Переключить оформление приложения"/>
                <Button x:Name="LogoutButton" Grid.Column="3" Content="Выйти" Click="LogoutButton_Click"
                        ToolTip="Выйти из учётной записи" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Сюда загружаются страницы. Панель навигации по умолчанию скрыта -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"
               FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource TextBrush}"
               Navigated="MainFrame_Navigated"/>

        <!-- НИЖНЯЯ ПАНЕЛЬ: кто вошёл и текущая дата/время -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="UserText" Text=""
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="DateTimeNow" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
